{
  // Main process + preload (Node / Electron).
  // Incremental migration: .ts files are checked strictly, untouched .js files
  // are only read for type inference (allowJs) and never reported (checkJs off).
  // Every option is spelled out because TypeScript 6 changed several defaults.
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsc/node.tsbuildinfo"
  },
  "include": ["src/main/**/*", "src/preload/**/*"]
}
