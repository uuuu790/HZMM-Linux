{
  // Renderer (React, browser). Same incremental rules as tsconfig.node.json.
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/renderer/src/*"]
    },
    "tsBuildInfoFile": "./node_modules/.cache/tsc/web.tsbuildinfo"
  },
  // The window.api contract and the pure domain types it builds on (no
  // imports, so no Node/Electron types leak into the renderer).
  "include": ["src/renderer/src/**/*", "src/preload/api.d.ts", "src/main/ipc/types.ts"]
}
