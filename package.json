{
  "name": "hzmm-linux-app",
  "version": "2.0.0",
  "description": "HumanitZ Mod Manager (Linux)",
  "homepage": "https://github.com/uuuu790/HZMM-Linux",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "electron-vite build && electron-builder --linux --config",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "test:sim": "electron-vite build && electron-builder --linux dir --config && playwright test --config=playwright.sim.config.mjs",
    "audit": "node scripts/audit.mjs",
    "typecheck": "tsc -b",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "check": "npm run audit && npm run lint && npm run typecheck && npm run check:ipc && npm test",
    "fix:dev-icon": "node scripts/fix-dev-icon.js",
    "postinstall": "node scripts/fix-7za-perms.mjs"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "7zip-bin": "^5.2.0",
    "dompurify": "^3.4.12",
    "electron-window-state": "^5.0.3",
    "luaparse": "^0.3.1",
    "marked": "^18.0.3",
    "node-7z": "^3.0.0",
    "node-stream-zip": "^1.15.0",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "happy-dom": "^20.9.0",
    "jsdom": "^29.1.1",
    "lucide-react": "^0.468.0",
    "mock-fs": "^5.5.0",
    "rcedit": "^5.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.6"
  }
}
